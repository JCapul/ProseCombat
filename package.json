{
  "name": "prose-combat",
  "version": "0.1.0",
  "description": "Local-first, distraction-free WYSIWYG Markdown editor with critique-only AI editorial review.",
  "main": "./out/main/index.js",
  "author": "ProseCombat",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCapul/ProseCombat.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release:win": "electron-vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.prosecombat.app",
    "productName": "ProseCombat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["out/**/*"],
    "publish": {
      "provider": "github",
      "owner": "JCapul",
      "repo": "ProseCombat",
      "releaseType": "draft"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icons",
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "cmdk": "^1.1.1",
    "electron-store": "^11.0.2",
    "marked": "^17.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
