{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron/**/*", "shared/**/*", "providers/**/*", "electron.vite.config.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@providers/*": ["providers/*"]
    }
  }
}
